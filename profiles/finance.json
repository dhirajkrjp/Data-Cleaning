{
    "domain": "finance",
    "description": "Accounting, Invoicing & Tax Compliance Profile",
    "email_keywords": [
        "email"
    ],
    "phone_keywords": [
        "phone",
        "mobile"
    ],
    "currency_keywords": [
        "amount",
        "price",
        "tax",
        "gst",
        "debit",
        "credit",
        "balance"
    ],
    "quantity_keywords": [
        "quantity",
        "qty"
    ],
    "date_keywords": [
        "date",
        "due"
    ],
    "name_keywords": [
        "client_name",
        "vendor_name",
        "name"
    ],
    "city_keywords": [
        "city",
        "state"
    ],
    "title_case_keywords": [
        "status",
        "payment_mode"
    ],
    "city_aliases": {
        "bangalore": "Bengaluru",
        "bombay": "Mumbai"
    },
    "invalid_placeholders": [
        "unknown",
        "null",
        "nan",
        "n/a",
        "none",
        "error",
        "-"
    ],
    "computed_columns": [
        {
            "target": "total_amount",
            "formula": "subtotal + tax_amount",
            "only_if_empty": true
        }
    ],
    "regex_validations": {
        "pan_number": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
        "gstin": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"
    },
    "allowed_values": {
        "invoice_status": [
            "Paid",
            "Unpaid",
            "Overdue",
            "Cancelled"
        ]
    },
    "column_overrides": {}
}